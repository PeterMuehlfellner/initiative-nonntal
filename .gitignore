# Local tool settings
.claude/settings.local.json

# Note: the generated files (assets/figures.js, assets/figure-*.svg,
# assets/palette.css, data/measurements.json, single-page.html) are
# deliberately NOT ignored. The site has to run without a build step: drop the
# folder on a webspace and you are done. To regenerate them, run
# `python3 data/build.py` and `python3 data/bundle.py`.

# The snapshots/ folder predates this repository and stays on disk as a plain
# copy. Git handles versions from here on, and the 1.7 MB page screenshot in
# there does not belong in the history. To track it anyway: `git add -f
# snapshots/`.
snapshots/
